+            vllm_config, "_ascend_skip_minimax_pp_capacity_check", False
+        ):
+            continue
         _check_enough_kv_cache_memory(
             avail_mem,
             partial(_max_memory_usage_bytes_from_groups, builder, vllm_config, groups),
